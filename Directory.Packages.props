<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.91"/>
    </ItemGroup>
    <ItemGroup>
        <!-- The NuGet feed's version rules. Deliberately only this one of NuGet's client packages:
             NuGet.Packaging would bring Newtonsoft.Json and the signing stack with it, which is the
             end of being trim- and AOT-clean; the nuspec is read by hand instead. -->
        <PackageVersion Include="NuGet.Versioning" Version="7.9.0"/>
        <PackageVersion Include="Shiny.Net.Discovery" Version="5.9.0"/>
        <PackageVersion Include="Shiny.DocumentDb" Version="14.0.0"/>
        <PackageVersion Include="SSH.NET" Version="2026.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Test-only -->
        <PackageVersion Include="xunit.v3" Version="3.2.2"/>
        <!-- Keep in lockstep with the Microsoft.Testing.Platform version xunit.v3 resolves (1.9.1). -->
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1"/>
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.10"/>
        <PackageVersion Include="NuGet.Protocol" Version="7.9.0"/>
        <PackageVersion Include="Shiny.DocumentDb.Sqlite" Version="14.0.0"/>
        <!-- Pinned past the version Shiny.DocumentDb.Sqlite brings (2.1.11, GHSA-2m69-gcr7-jv3q). Test-only. -->
        <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13"/>
        <PackageVersion Include="Shiny.Net.HttpServer.FileSync.Client" Version="2.1.1"/>
    </ItemGroup>
</Project>
